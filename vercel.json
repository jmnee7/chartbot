{
  "version": 2,
  "buildCommand": "echo 'No build needed - static files only'",
  "outputDirectory": "docs",
  "routes": [
    { "src": "/(.*)", "dest": "/$1" },
    { "src": "/r/streaming/mv", "status": 308, "headers": { "Location": "/index.html#/streaming/mv" } },
    { "src": "/r/g/streaming/(.*)", "status": 308, "headers": { "Location": "/index.html#/guide/streaming?tab=$1" } },
    { "src": "/r/g/id/(.*)", "status": 308, "headers": { "Location": "/index.html#/guide/id?tab=$1" } },
    { "src": "/r/g/download/(audio|mv)/(.*)", "status": 308, "headers": { "Location": "/index.html#/guide/download?cat=$1&svc=$2" } },
    { "src": "/r/g/cheer/([^/]+)$", "status": 308, "headers": { "Location": "/index.html#/guide/cheer?album=$1" } },
    { "src": "/r/g/cheer/([^/]+)/([^/]+)$", "status": 308, "headers": { "Location": "/index.html#/guide/cheer?album=$1&track=$2" } },
    { "src": "/r/g/radio", "status": 308, "headers": { "Location": "/index.html#/guide/radio" } },
    { "src": "/r/support/(helper|team|id|fundraising)", "status": 308, "headers": { "Location": "/index.html#/support/$1" } },
    { "src": "/r/vote/collect/(theshow|showchampion|musicbank|musiccore|inkigayo|mcountdown)", "status": 308, "headers": { "Location": "/index.html#/vote/collect?tab=$1" } },
    { "src": "/r/vote/rate", "status": 308, "headers": { "Location": "/index.html#/vote/rate" } }
  ]
}
    ,
    /* Vote rate */
    { "src": "/r/vote/rate", "status": 308, "headers": { "Location": "/index.html#/vote/rate" } }
    ,
    /* Vo    ,
    /* Vote rate */
    { "src": "/r/vote/rate", "status": 308, "headers": { "Location": "/index.html#/vote/rate" } }
